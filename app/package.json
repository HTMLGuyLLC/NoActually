    "@tauri-apps/cli": "2.12.4",
    "@vitest/coverage-v8": "5.0.5",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
